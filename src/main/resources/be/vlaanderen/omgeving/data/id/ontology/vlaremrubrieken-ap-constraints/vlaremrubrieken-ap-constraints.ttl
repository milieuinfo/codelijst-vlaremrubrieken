omg_ont:vlaremrubrieken-ap-constraints
    a owl:Ontology ;
    rdfs:comment
        "Specifieert hoe de data in de codelijst vlaremrubrieken te encoderen in RDF (i.e. RDF termen, kardinaliteiten,...)."@en ;
    rdfs:label "vlaremrubrieken AP Constraints"@en ;
    dct:abstract "Het vlaremrubrieken applicatieprofiel specifieert de RDF termen (klassen en properties) en bijhorende constraints die gebruikt worden voor het beschrijven van de codelijst vlaremrubrieken. Het maakt hierbij zoveel mogelijk gebruik van bestaande termen (klassen en properties) uit bestaande vocabularia zoals skos en dcterms."@en ;
    dct:alternative "vlaremrubrieken AP Shapes"@en ;
    dct:creator omg_ag_cl:creator ;
    dct:description "Dit is de SHACL encodering van het applicatieprofiel van de codelijst vlaremrubrieken."@en ;
    dct:issued "2026-10-26"^^xsd:date ;
    dct:title "vlaremrubrieken AP Constraints"@en ;
    xkos:belongsTo omg_dataset:codelijst-vlaremrubrieken ;
    xhv:last omg_voc:vlaremrubrieken-ap-constraints ;
    owl:sameAs omg_voc:vlaremrubrieken-ap-constraints ;
    owl:versionInfo "Versie 0.1.0"@en .


